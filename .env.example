# ==========================================================
# FallGuard AI Environment Configuration
# Research & Prototype Wearable Fall Detection System
# ==========================================================

# Application
APP_NAME=FallGuard AI
ENVIRONMENT=development
DEBUG=True
PORT=8000

# Database Configuration (PostgreSQL for prod/docker, SQLite fallback for zero-setup local run)
DATABASE_URL=postgresql://fallguard:fallguard_secret@localhost:5432/fallguard_db
# Local SQLite override: sqlite:///./fallguard.db

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEP_ALIVE=60
MQTT_TOPIC_PREFIX=fallguard

# LLM Provider Configuration ('mock', 'openai', 'gemini', 'anthropic')
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Vector Database (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./chroma_data

# Notification Provider ('mock', 'twilio', 'fcm', 'email')
NOTIFICATION_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Location Provider ('mock', 'gps', 'ip')
LOCATION_PROVIDER=mock

# Security
JWT_SECRET=super-secret-fallguard-key-change-in-production-2026
API_KEY_HEADER=X-FallGuard-Key

# Biomechanical Signal Processing & Fall Detection Thresholds
SAMPLING_RATE_HZ=100
WINDOW_SIZE_SAMPLES=500
STRIDE_SAMPLES=50
LOW_PASS_CUTOFF_HZ=5.0
FALL_HIGH_CONFIDENCE_THRESHOLD=0.85
FALL_MEDIUM_CONFIDENCE_THRESHOLD=0.50
IMPACT_ACCEL_PEAK_THRESHOLD_G=2.8
FREE_FALL_VALLEY_THRESHOLD_G=0.5
LOW_MOTION_THRESHOLD=0.08
IMMOBILITY_DURATION_SECONDS=10
USER_CONFIRMATION_TIMEOUT_SECONDS=30
DUPLICATE_EVENT_SUPPRESSION_SECONDS=15
